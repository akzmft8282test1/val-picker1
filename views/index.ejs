<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>발로란트 내전 매칭 시스템</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <h1>VALORANT CUSTOM MATCH</h1>

    <!-- 플레이어 등록 영역 -->
    <section class="card">
      <h2>👤 참가자 등록</h2>
      <form id="playerForm">
        <input type="text" id="playerName" placeholder="닉네임 입력" required>
        <select id="playerTier" required>
          <option value="아이언">아이언</option>
          <option value="브론즈">브론즈</option>
          <option value="실버" selected>실버</option>
          <option value="골드">골드</option>
          <option value="플래티넘">플래티넘</option>
          <option value="다이아몬드">다이아몬드</option>
          <option value="초월자">초월자</option>
          <option value="불멸">불멸</option>
          <option value="레디언트">레디언트</option>
        </select>
        <button type="submit">등록</button>
      </form>

      <!-- 호버 이벤트 적용되는 플레이어 목록 -->
      <div id="playerList" class="player-tags">
        <% players.forEach(p => { %>
          <div class="player-tag" data-id="<%= p.id %>" data-score="<%= p.tier_score %>" data-name="<%= p.name %>" data-tier="<%= p.tier %>">
            <span><%= p.name %></span>
            <!-- 호버 시 노출되는 티어 정보 -->
            <div class="tier-hover-card">
              <span class="tier-title"><%= p.tier %></span>
            </div>
            <button onclick="removePlayer('<%= p.id %>')" class="btn-del">×</button>
          </div>
        <% }) %>
      </div>
      <button onclick="clearAllPlayers()" class="btn-secondary">전체 초기화</button>
    </section>

    <!-- 팀 뽑기 영역 -->
    <section class="card">
      <h2>⚔️ 팀 나누기</h2>
      <button onclick="generateTeams('balanced')" class="btn-primary">밸런스 팀 뽑기</button>
      <button onclick="generateTeams('random')" class="btn-secondary">완전 랜덤 팀 뽑기</button>

      <div class="teams-container">
        <div class="team-box team-a">
          <h3>RED TEAM <span id="scoreA"></span></h3>
          <ul id="teamA"></ul>
        </div>
        <div class="team-box team-b">
          <h3>BLUE TEAM <span id="scoreB"></span></h3>
          <ul id="teamB"></ul>
        </div>
      </div>
    </section>

    <!-- 맵 추첨 및 밴픽 (13개 맵) -->
    <section class="card">
      <h2>🗺️ 맵 선택 (13개)</h2>
      <button onclick="pickRandomMap()" class="btn-primary">랜덤 맵 추첨</button>
      <div id="selectedMap" class="map-result">맵을 추첨해주세요!</div>
      
      <div class="map-grid" id="mapGrid">
        <!-- JS로 13개 맵 동적 생성 -->
      </div>
    </section>

    <!-- [추가 기능] 공수 결정 룰렛 및 요원 뽑기 -->
    <section class="card extra-tools">
      <h2>🎲 추가 내전 툴</h2>
      <div class="tool-group">
        <button onclick="rollSide()" class="btn-secondary">공/수 진영 주사위</button>
        <span id="sideResult" class="tool-result"></span>
      </div>
      <div class="tool-group">
        <button onclick="pickRandomAgent()" class="btn-secondary">랜덤 요원 추천</button>
        <span id="agentResult" class="tool-result"></span>
      </div>
    </section>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
